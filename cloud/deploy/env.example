# Install as /etc/agent-notifier.env  (chmod 640, owner root:notify). NEVER commit.

# Public HTTPS address of this service (no trailing slash)
PUBLIC_URL=https://YOUR_DOMAIN

# Telegram bot (create a NEW bot with @BotFather -> /newbot)
TG_BOT_TOKEN=
TG_BOT_USERNAME=
# 16+ chars, letters digits _ -   (python3 -c "import secrets;print(secrets.token_hex(24))")
TG_WEBHOOK_SECRET=

# 32+ chars   (python3 -c "import secrets;print(secrets.token_urlsafe(48))")
SESSION_SECRET=

# Where "/" redirects (your Vercel landing page). Optional.
LANDING_URL=

# Defaults are fine
HOST=127.0.0.1
PORT=8787
DB_PATH=/var/lib/agent-notifier/notify.db
NTFY_SERVER=https://ntfy.sh
RATE_PER_MIN=10
RATE_PER_DAY=300

# Super-admins: comma-separated Telegram numeric IDs (get yours with @userinfobot or the bot's /start logs).
# Admins get the /admin console. Leave empty to disable it.
ADMIN_TG_IDS=
