# Copy to .env (next to pyproject.toml) or to ~/.agent-notifier/.env
# Real environment variables override this file. NEVER commit .env.

# --- Routing ---------------------------------------------------------------
# normal/low priority goes to these. high/urgent goes to ALL configured channels.
NOTIFY_DEFAULT_CHANNELS=telegram,ntfy
# Hook: skip the "finished" ping if the run took less than this many seconds
NOTIFY_MIN_SECONDS=45

# --- Telegram (free, two-way: replies come back to Claude) ------------------
# 1) @BotFather -> /newbot -> token   2) message your bot once
# 3) run: agent-notifier telegram-id   (prints your chat id)
TG_TOKEN=8972013361
TG_CHAT_ID=AAECXksnTNZhTiyKbTFxzEnc9ACghLUheXA

# --- ntfy (free push to phone, no account needed) ---------------------------
# Install the ntfy app, subscribe to a long random topic name.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=https://ntfy.sh/agent_notifier
# optional: only if you use a protected/self-hosted server
NTFY_TOKEN=
# optional: second topic you can publish to from your phone to message Claude
NTFY_INBOX_TOPIC=

# --- Gmail (SMTP with an App Password; needs 2FA on the Google account) -----
# https://myaccount.google.com/apppasswords
GMAIL_USER=terminal123b@gmail.com
GMAIL_APP_PASSWORD=yuleohozhxxbajxx

# defaults to GMAIL_USER
GMAIL_TO=

# --- WhatsApp via CallMeBot (free, personal use, outbound only) -------------
# Activation: https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# --- Telegram wake-up bridge (agent-notifier listen) -----------------------
# A SEPARATE bot from TG_TOKEN. Do not reuse the notifier bot.
BRIDGE_TG_TOKEN=
BRIDGE_TG_CHAT_ID=
# claude | codex | opencode | custom
BRIDGE_AGENT=claude
# required: an existing directory the agent works in (must be inside BRIDGE_ROOTS)
BRIDGE_WORKDIR=
# allowed roots (semicolon on Windows, colon elsewhere, or JSON array)
BRIDGE_ROOTS=
# readonly | edit | full
BRIDGE_PERMISSIONS=edit
BRIDGE_TIMEOUT=900
BRIDGE_QUEUE_MAX=5
# optional PIN (constant-time checked)
BRIDGE_PIN=
# for --agent custom, e.g. mytool --ask {message}
BRIDGE_AGENT_CMD=
# optional dotenv file of extra env vars for the agent (third-party providers)
BRIDGE_AGENT_ENV_FILE=
# full mode auto-reverts to edit after this many minutes (0 = never)
BRIDGE_FULL_TTL=120
# enable /sh raw shell (requires full mode)
BRIDGE_ALLOW_SHELL=false
BRIDGE_SHELL_TIMEOUT=120
# optional custom agents: name=command pairs, comma separated
BRIDGE_AGENTS_CUSTOM=
